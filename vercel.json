{
  "framework": "nextjs",
  "installCommand": "cd apps/web && npm install --package-lock-only --ignore-scripts && npm ci",
  "buildCommand": "cd apps/web && npm run build",
  "devCommand": "cd apps/web && npm run dev",
  "crons": [
    {
      "path": "/api/cron/verificaciones",
      "schedule": "30 12 * * 1-5"
    },
    {
      "path": "/api/cron/contratos-vencidos",
      "schedule": "15 3 * * *"
    }
  ]
}
